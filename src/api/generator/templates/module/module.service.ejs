/* eslint-disable @typescript-eslint/no-unused-vars */
import {
  Injectable,
  BadRequestException,
  InternalServerErrorException,
  NotFoundException,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, In, FindOptionsWhere } from 'typeorm';
import { GlobalService } from '../../utils/global/global.service';
import { <%= entityName %> } from './entities/<%= entityFileName %>.entity';
import {
  PaginationResDto,
  ServiceResDto,
} from '../../utils/global/dto/global.dto';
import {
  PrimaryKeys<%= className %>Dto,
  Create<%= entityName %>BodyReqDto,
  UpdateAndDelete<%= className %>BodyReqDto,
} from './dto/<%= entityFileName %>.dto';
import { ModelService } from '../../utils/model/model.service';
import { DeleteRollBackDto } from '../../utils/model/model.dto';
import { CustomLogger } from '../../utils/logger/logger.service';
import { syncManyToManyRelation } from '../../utils/relation-utils';
<% if(creationConfig?.operator) { %>
import { User } from '../user/entities/user.entity';
<% } %>
<% const importedRelations = new Set(); %>
<% fields.forEach(field => { %>
  <% if (field.relation && field.relation.type === 'ManyToMany' && !importedRelations.has(field.relation.target)) { 
       const relationFile = field.relation.target.toLowerCase();
       const relatedClass = field.relation.target[0].toUpperCase() + field.relation.target.slice(1);
       importedRelations.add(field.relation.target);
  %>
import { MultiplePrimaryKeys<%= relatedClass %>Dto } from '../<%= relationFile %>/dto/<%= relationFile %>.dto';
import { <%= relatedClass %> } from '../<%= relationFile %>/entities/<%= relationFile %>.entity';
  <% } %>
<% }) %>

@Injectable()
export class <%= entityName %>Service {
  constructor(
    @InjectRepository(<%= entityName %>)
    private <%= entityVar %>Repository: Repository<<%= entityName %>>,
    <% importedRelations.forEach(entity => { %>
    @InjectRepository(<%= entity %>)
    private <%= entity.toLowerCase() %>Repository: Repository<<%= entity %>>,
    <% }) %>
    private globalService: GlobalService,
    private modelService: ModelService,
    private readonly customLogger: CustomLogger,
  ) {}

  // Helper to build where clause for primary keys
  private buildPrimaryKeyWhere(primaryKeyFields: PrimaryKeys<%= className %>Dto): FindOptionsWhere<<%= entityName %>> {
    return {
      <% if (primaryFields) { %>
        <% primaryFields.forEach(element => { %>
      <%= element.name %>: primaryKeyFields.<%= element.name %>,
        <% }) %>
      <% } else { %>
      id: primaryKeyFields.id,
      <% } %>
    };
  }

  // Helper for error handling
  private handleError(method: string, error: any): never {
    this.customLogger.error(`Error in ${method}:`, error.stack);
    throw error instanceof BadRequestException || error instanceof NotFoundException
      ? error
      : new InternalServerErrorException(`Failed to ${method.toLowerCase()}`);
  }

  async findMany(
    where: FindOptionsWhere<<%= entityName %>> = {},
    page: number,
    limit: number,
  ): Promise<ServiceResDto<<%= entityName %>[]>> {
    try {
      const skip = this.globalService.getSkipRecord(page, limit);
      const [data, count] = await this.<%= entityVar %>Repository.findAndCount({
        where,
        take: limit,
        skip,
        relations: this.<%= entityVar %>Repository.metadata.relations.map(rel => rel.propertyName),
      });
      return {
        data,
        pagination: this.globalService.setPagination(page, limit, count),
      };
    } catch (error) {
      this.handleError('findMany', error);
    }
  }

  async create(
    createDto: Create<%= entityName %>BodyReqDto,
    <% if(creationConfig?.operator) { %>
    createdByUser: User,
    <% } %>
  ): Promise<<%= entityName %>> {
    try {
      const entity = this.<%= entityVar %>Repository.create({
        ...createDto,
        <% if(creationConfig?.operator) { %>
        createdBy: createdByUser,
        updatedBy: createdByUser,
        <% } %>
      });
      const savedEntity = await this.<%= entityVar %>Repository.save(entity);
      if (!savedEntity) throw new BadRequestException('Failed to create <%= entityName %>');
      return this.modelService.removeUserBy(savedEntity);
    } catch (error) {
      this.handleError('create', error);
    }
  }

  async findOne(primaryKeyFields: PrimaryKeys<%= className %>Dto): Promise<<%= entityName %>> {
    try {
      const data = await this.<%= entityVar %>Repository.findOne({
        where: this.buildPrimaryKeyWhere(primaryKeyFields),
        relations: this.<%= entityVar %>Repository.metadata.relations.map(rel => rel.propertyName),
      });
      if (!data) throw new NotFoundException('<%= entityName %> not found');
      return data;
    } catch (error) {
      this.handleError('findOne', error);
    }
  }

  async update(
    updateDto: UpdateAndDelete<%= className %>BodyReqDto,
    primaryKeyFields: PrimaryKeys<%= className %>Dto,
    <% if(creationConfig?.operator) { %>
    updatedByUser: User,
    <% } %>
    <% if (creationConfig?.withSoftDelete) { %>
    isRollback = false,
    <% } %>
  ): Promise<<%= entityName %>> {
    try {
      const options = {
        where: this.buildPrimaryKeyWhere(primaryKeyFields),
        <% if (creationConfig?.withSoftDelete) { %>
        ...(isRollback ? { withDeleted: true } : {}),
        <% } %>
      };
      const entity = await this.<%= entityVar %>Repository.findOne(options);
      if (!entity) throw new NotFoundException('<%= entityName %> not found');

      const updatedEntity = this.modelService.updateModelValue(
        entity,
        updateDto,
        <% if(creationConfig?.operator) { %>
        updatedByUser,
        <% } %>
      );
      return await this.<%= entityVar %>Repository.save(updatedEntity);
    } catch (error) {
      this.handleError('update', error);
    }
  }

  async delete(primaryKeyFields: PrimaryKeys<%= className %>Dto): Promise<boolean> {
    try {
      const entity = await this.<%= entityVar %>Repository.findOne({
        where: this.buildPrimaryKeyWhere(primaryKeyFields),
        withDeleted: true,
      });
      if (!entity) throw new NotFoundException('<%= entityName %> not found');
      <% if (creationConfig?.withSoftDelete) { %>
      if (!entity.deletedAt) throw new BadRequestException('Only soft-deleted records can be permanently deleted');
      <% } %>
      const result = await this.<%= entityVar %>Repository.delete(primaryKeyFields);
      return !!result.affected;
    } catch (error) {
      this.handleError('delete', error);
    }
  }

<% fields.forEach(field => { %>
  <% if (field.relation?.type === 'ManyToMany') { %>
    <% const relatedClass = field.relation.target[0].toUpperCase() + field.relation.target.slice(1); %>
    <% const fieldNameCapitalized = field.name.charAt(0).toUpperCase() + field.name.slice(1); %>
  async modify<%= fieldNameCapitalized %>(
    connectIds: MultiplePrimaryKeys<%= relatedClass %>Dto,
    disconnectIds: MultiplePrimaryKeys<%= relatedClass %>Dto,
    primaryKeyFields: PrimaryKeys<%= className %>Dto,
  ): Promise<<%= entityName %>> {
    try {
      const entity = await this.<%= entityVar %>Repository.findOne({
        where: this.buildPrimaryKeyWhere(primaryKeyFields),
        relations: ['<%= field.name %>'],
      });
      if (!entity) throw new NotFoundException('<%= entityName %> not found');

      const fetchEntities = async (ids: MultiplePrimaryKeys<%= relatedClass %>Dto): Promise<<%= relatedClass %>[]> => {
        if (!ids?.items?.length) return [];
        const entities = await this.<%= field.relation.target.toLowerCase() %>Repository.find({
          where: ids.items as FindOptionsWhere<<%= relatedClass %>>[],
        });
        if (entities.length !== ids.items.length) {
          throw new NotFoundException(`Some or all <%= relatedClass %> not found`);
        }
        return entities;
      };

      const [entitiesToAdd, entitiesToRemove] = await Promise.all([
        fetchEntities(connectIds),
        fetchEntities(disconnectIds),
      ]);

      entity['<%= field.name %>'] = syncManyToManyRelation(
        entity['<%= field.name %>'],
        entitiesToAdd,
        entitiesToRemove,
        this.<%= field.relation.target.toLowerCase() %>Repository.metadata,
      );

      return await this.<%= entityVar %>Repository.save(entity);
    } catch (error) {
      this.handleError('modify<%= fieldNameCapitalized %>', error);
    }
  }
  <% } %>
<% }) %>
}