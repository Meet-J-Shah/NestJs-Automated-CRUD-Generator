/* eslint-disable @typescript-eslint/no-unused-vars */
import {
  IsNotEmpty, IsDefined, MaxLength, IsString, IsBoolean, IsObject, ArrayNotEmpty,
  IsOptional, IsArray, IsInt, IsIn, Matches, IsUUID, ValidateNested, IsEmail,
  Min, Max, IsISO8601, IsPhoneNumber, IsNumber,
} from 'class-validator';
import { ApiProperty } from '@nestjs/swagger';
import { Transform, Type } from 'class-transformer';
import { IntersectionType } from '@nestjs/mapped-types';
import { IsDynamicPassword } from '../../../validators/passwordVail.validator';

<% if (fields.some(field => field.relation)) { %>
  <% const importedRelations = new Set(); %>
  <% fields.forEach(field => {
    if (field.relation && !importedRelations.has(field.relation.target)) {
      importedRelations.add(field.relation.target);
  %>
  import { <%= field.relation.target %>ResponseDto } from '../../<%= field.relation.target.toLowerCase() %>/dto/<%= field.relation.target.toLowerCase() %>.dto';
  <% } }); %>
<% } %>




// FindMany Query DTO
export class FindMany<%= className %>QueryReq {
  @IsInt()
  @Transform(({ value }) => Number.parseInt(value))
  @ApiProperty({ example: 1, description: 'Page number for pagination' })
  page: number;

  @IsInt()
  @Transform(({ value }) => Number.parseInt(value))
  @ApiProperty({ example: 10, description: 'Number of items per page' })
  limit: number;
}

// Primary Keys DTO
export class PrimaryKeys<%= className %>Dto {
  <% const peimaryFields = primaryFields?.length ? primaryFields : [{ name: 'id', dtype: 'bigint', tsType: 'string' }]; %>

  <% peimaryFields.forEach(field => { %>
    <% if (field.dtype === 'uuid') { %>
      @IsUUID()
      @ApiProperty({
        example: 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11',
        description: 'UUID primary key field',
        type: 'string',
        format: 'uuid',
      })
    <% } else if (field.dtype === 'int') { %>
      @Type(() => Number)
      @IsInt()
      @ApiProperty({
        example: 123,
        description: 'Integer primary key',
        type: 'integer',
        format: 'int32',
      })
    <% } else { %>
      @IsString()
      @Matches(/^\d+$/, { message: 'ID must be a string of digits' })
      @ApiProperty({
        example: '9223372036854775807',
        description: 'BigInt primary key field (as string)',
        type: 'string',
      })
    <% } %>
    @IsNotEmpty()
    <%= field.name %>: <%= field.tsType || field.type || 'string' %>;
  <% }) %>
}


// Multiple Primary Keys DTO
export class MultiplePrimaryKeys<%= className %>Dto {
  @ValidateNested({ each: true })
  @Type(() => PrimaryKeys<%= className %>Dto)
  @ApiProperty({ type: [PrimaryKeys<%= className %>Dto], description: 'Array of primary keys for bulk actions' })
  items: PrimaryKeys<%= className %>Dto[];
}

// Create DTO
export class Create<%= className %>BodyReqDto <% if (primaryFields && primaryFields.length > 1) { %>extends PrimaryKeys<%= className %>Dto<% } %> {
<% fields.forEach(field => { %>
  <% if (field.relation) { %>
    <% if (['OneToOne', 'ManyToOne'].includes(field.relation.type)) { %>
  @IsOptional()
  @IsString()
  @ApiProperty({ example: '9223372036854775807', description: 'BigInt foreign key field (as string)', type: 'string', required: <%= !field.nullable %> })
  <%= field.name %>Id?: string;
    <% } else { %>
  @IsOptional()
  @IsArray()
  @IsString({ each: true })
  @ApiProperty({ example: ['9223372036854775807', '9223372036854775806'], description: 'Array of BigInt foreign keys (each as string)', type: 'array', items: { type: 'string', example: '9223372036854775807' }, required: <%= !field.nullable %> })
  <%= pluralize.singular(field.name) %>Ids?: string[];
    <% } %>
  <% } else { %>
  @ApiProperty(<%- JSON.stringify(getApiProperty(field), null, 2) %>)
 <%- applyValidation(field) %>
  <%= field.name %><% if (field.nullable) { %>?<% } %>: <%- field.enum ? (field.Type === 'Enum' ? field.enum.map(v => `'${v}'`).join(' | ') : `(${field.enum.map(v => `'${v}'`).join(' | ')})[]`) : field.tsType || field.type %>;
  <% } %>
<% }) %>
}

// Update DTO
export class Update<%= className %>BodyReqDto {
<% fields.forEach(field => { %>
  <% if (field.relation) { %>
    <% if (['OneToOne', 'ManyToOne'].includes(field.relation.type)) { %>
  @IsOptional()
  @IsString()
  @ApiProperty({ example: '9223372036854775807', description: 'BigInt foreign key field (as string)', type: 'string', required: false })
  <%= field.name %>Id?: string;
    <% } else { %>
  @IsOptional()
  @IsArray()
  @IsString({ each: true })
  @ApiProperty({ example: ['9223372036854775807', '9223372036854775806'], description: 'Array of BigInt foreign keys (each as string)', type: 'array', items: { type: 'string', example: '9223372036854775807' }, required: false })
  <%= pluralize.singular(field.name) %>Ids?: string[];
    <% } %>
  <% } else { %>
  <%- applyValidation(field, true) %>
  <%
  const apiPropertyObj = {
    ...getApiProperty(field),
    required:  false,
  };
%>
@ApiProperty(<%- JSON.stringify(apiPropertyObj, null, 2) %>)
  <%= field.name %>?: <%- field.enum ? (field.Type === 'Enum' ? field.enum.map(v => `'${v}'`).join(' | ') : `(${field.enum.map(v => `'${v}'`).join(' | ')})[]`) : field.tsType || field.type %>;
  <% } %>
<% }) %>
}

<% if (creationConfig?.withSoftDelete) { %>
// Delete DTO
export class Delete<%= className %>BodyReqDto {
  @IsBoolean()
  @IsOptional()
  @ApiProperty({ example: true, description: 'True to soft delete the <%= className %>', required: false })
  hasSoftDeleted?: boolean;
}
<% } %>

// Update and Delete DTO
export class UpdateAndDelete<%= className %>BodyReqDto extends IntersectionType(
  Update<%= className %>BodyReqDto,
  <% if (creationConfig?.withSoftDelete) { %>Delete<%= className %>BodyReqDto,<% } %>
) {}

// Response DTO
export class <%= className %>ResponseDto {
<% if (primaryFields && primaryFields.length > 0) { %>
  <% primaryFields.forEach(field => { %>
  @ApiProperty({ example: '<%= field.example || (field.dtype === 'uuid' ? 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11' : field.dtype === 'int' ? 123 : '9223372036854775807') %>' })
  <%= field.name %>: <%- field.type || 'string' %>;
  <% }) %>
<% } else { %>
  @ApiProperty({ example: '1' })
  id: string;
<% } %>

<% fields.forEach(field => { if (field.Type === 'Password' || field.name === 'deletedAt' || field.name === 'deletedBy') return; %>
  <% if (field.relation) { %>
    @ApiProperty({ type: () => <%= field.relation.isArray ? `[${field.relation.target}ResponseDto]` : `${field.relation.target}ResponseDto` %>, required: false })
    <%= field.name %>: <%= field.relation.isArray ? `${field.relation.target}ResponseDto[]` : `${field.relation.target}ResponseDto` %>;
  <% } else { %>
    @ApiProperty({
      <% if (field.dtype === 'enum') { %>
        enum: <%- JSON.stringify(field.enum) %>,
        example: '<%- field.enum[0] %>',
      <% } else if (field.dtype === 'simple-array' && field.enum) { %>
        type: [String],
        enum: <%- JSON.stringify(field.enum) %>,
        example: [<%- field.enum.slice(0, 2).map(v => `'${v}'`).join(', ') %>],
      <% } else if (field.dtype === 'decimal') { %>
        type: String,
        example: '<%= field.default || "12345678.99" %>',
        description: 'Decimal value<%= field.subTypeOptions?.m ? ` (precision: ${field.subTypeOptions.m}` : "" %><%= field.subTypeOptions?.d ? `, scale: ${field.subTypeOptions.d})` : "" %>',
      <% } else if (field.dtype === 'json') { %>
        type: 'object',
        example: { key: 'value' },
        description: 'JSON data',
      <% } else if (['datetime', 'timestamp'].includes(field.dtype)) { %>
        type: String,
        format: 'date-time',
        example: '2025-01-01T12:00:00Z',
      <% } else if (field.dtype === 'date') { %>
        type: String,
        format: 'date',
        example: '2025-01-01',
      <% } else if (field.dtype === 'time') { %>
        type: String,
        example: '15:30:00',
      <% } else if (field.dtype === 'boolean') { %>
        type: Boolean,
        example: true,
      <% } else if (['int', 'smallint', 'bigint'].includes(field.dtype)) { %>
        type: Number,
        example: 123,
      <% } else { %>
        type: String,
        example: '<%- field.default || field.name %>',
      <% } %>
    })
    <%= field.name %>: <%- field.enum ? (field.dtype === 'enum' ? field.enum.map(v => `'${v}'`).join(' | ') : `(${field.enum.map(v => `'${v}'`).join(' | ')})[]`) : field.dtype === 'json' ? 'Record<string, any>' : field.dtype === 'datetime' || field.dtype === 'timestamp' ? 'Date' : field.dtype === 'boolean' ? 'boolean' : field.dtype === 'int' || field.dtype === 'smallint' || field.dtype === 'bigint' ? 'number' : 'string' %>;
  <% } %>
<% }) %>

<% if (creationConfig?.withTimestamps) { %>
  @ApiProperty({ type: String, format: 'date-time', example: '2024-01-01T12:00:00Z' })
  createdAt: Date;

  @ApiProperty({ type: String, format: 'date-time', example: '2024-01-02T12:00:00Z' })
  updatedAt: Date;
<% } %>

<% if (creationConfig?.operator) { %>
  @ApiProperty({ type: () => UserResponseDto, required: false })
  createdBy?: UserResponseDto;

  @ApiProperty({ type: () => UserResponseDto, required: false })
  updatedBy?: UserResponseDto;
<% } %>
}